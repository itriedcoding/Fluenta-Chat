{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the Fluenta main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://discord.com/*" },
        { "url": "https://cdn.discordapp.com/*" },
        { "url": "https://media.discordapp.net/*" }
      ]
    }
  ]
}
