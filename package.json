{
  "name": "fluenta",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "Fluenta — a Discord client mod for Windows (Vencord-style), no token or bot required",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "icons": "node tools/gen-icons.mjs",
    "mod:build": "node mod/build.mjs",
    "mod:install": "npm run mod:build && node mod/dist/cli.cjs install",
    "mod:uninstall": "node mod/dist/cli.cjs uninstall",
    "mod:status": "node mod/dist/cli.cjs status",
    "mod:test": "node mod/build.mjs --tests && node --test \"mod/dist-tests/**/*.test.cjs\"",
    "mod:typecheck": "tsc --noEmit -p mod/tsconfig.json",
    "tauri": "tauri",
    "windows:dev": "tauri dev",
    "windows:build": "tauri build",
    "android:build": "npm run build && cap sync android",
    "android:open": "cap open android",
    "mod:exe": "node tools/build-sea.mjs",
    "android:mod": "node mod/build.mjs && cp mod/dist/renderer.js android-mod/app/src/main/assets/fluenta.js"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@electron/asar": "^3.2.10",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "@capacitor/cli": "^7.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "postject": "^1.0.0-alpha.6"
  }
}
